# =============================================================================
# InmuFacil — Variables de Entorno de Produccion
# INSTRUCCIONES: Copia este archivo como .env y rellena todos los valores.
# NUNCA subas el .env real al repositorio.
# =============================================================================

# --- Base de Datos PostgreSQL ---
POSTGRES_USER=inmufacil_user
POSTGRES_PASSWORD=CAMBIAR_POR_CONTRASENA_SEGURA
POSTGRES_DB=inmufacil_db
DATABASE_URL=postgresql+psycopg2://inmufacil_user:CAMBIAR_POR_CONTRASENA_SEGURA@db:5432/inmufacil_db

# --- Seguridad JWT ---
# Generar con: openssl rand -base64 32
SECRET_KEY=CAMBIAR_POR_VALOR_ALEATORIO_32_BYTES
SECRET_KEY_JWT=CAMBIAR_POR_VALOR_ALEATORIO_32_BYTES
JWT_SECRET_KEY=CAMBIAR_POR_VALOR_ALEATORIO_32_BYTES
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Cifrado PII (AES-256) ---
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INMUFACIL_MASTER_KEY=CAMBIAR_POR_CLAVE_FERNET_GENERADA

# --- Google Gemini AI ---
GEMINI_API_KEY=INTRODUCIR_CLAVE_DE_GOOGLE_AI_STUDIO

# --- Google OAuth ---
# Obten el Web Client ID en console.cloud.google.com > APIs > Credenciales
GOOGLE_WEB_CLIENT_ID=CAMBIAR_POR_WEB_CLIENT_ID.apps.googleusercontent.com

# --- Entorno ---
ENVIRONMENT=production
DEBUG=false
API_BASE_URL=https://inmufacil.com
