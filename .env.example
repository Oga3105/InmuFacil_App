# Backend environment variables — copy to .env and fill in values
# DO NOT commit .env — use this file as reference only

# ── Database ──────────────────────────────────────────────────────────────────
# Local development (outside Docker): localhost + mapped port
DATABASE_URL=postgresql+psycopg2://inmufacil_user:YOUR_PASSWORD@localhost:5435/inmufacil_db
# Inside Docker Compose / production server:
# DATABASE_URL=postgresql+psycopg2://inmufacil_user:YOUR_PASSWORD@db:5432/inmufacil_db

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_IN_PRODUCTION
ACCESS_TOKEN_EXPIRE_MINUTES=30
INMUFACIL_MASTER_KEY=BASE64_AES256_KEY_HERE
SECRET_KEY_JWT=BASE64_JWT_SECRET_HERE
JWT_SECRET_KEY=BASE64_JWT_SECRET_HERE

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true

# ── External APIs ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GOOGLE_WEB_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
