# ============================================================================
# InmuFácil - Environment Configuration Template
# ============================================================================
# CRITICAL: This file is a TEMPLATE. Copy it to .env and fill in your values.
# NEVER commit the actual .env file to version control!
#
# Setup Instructions:
# 1. Copy this file: cp .env.example .env
# 2. Generate encryption key: python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
# 3. Fill in all values below
# 4. Restart the application
# ============================================================================

# ============================================================================
# ENCRYPTION & SECURITY (CRITICAL - REQUIRED FOR STARTUP)
# ============================================================================

# Master encryption key for AES-256-GCM (32 bytes, base64 encoded)
# Generate with: python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
# CRITICAL: Keep this secret! Never share or commit to git!
INMUFACIL_MASTER_KEY=your_generated_key_here

# JWT Secret Key for authentication tokens
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY_JWT=your_jwt_secret_here

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Database URL (SQLite for development, PostgreSQL for production)
# Development (SQLite): sqlite:///./inmufacil.db
# Production (PostgreSQL): postgresql://user:password@localhost/inmufacil
DATABASE_URL=sqlite:///./inmufacil.db

# ============================================================================
# EMAIL CONFIGURATION (MFA)
# ============================================================================

# SMTP Configuration for email verification
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# SMTP_FROM=noreply@inmufacil.com

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

# Environment (development, staging, production)
ENVIRONMENT=development

# Debug mode (true/false)
DEBUG=true

# API Base URL
API_BASE_URL=http://localhost:8000

# ============================================================================
# SECURITY SETTINGS
# ============================================================================

# MFA token expiration (minutes)
MFA_TOKEN_EXPIRATION=15

# Max failed login attempts before lockout
MAX_FAILED_ATTEMPTS=3

# Account lockout duration (minutes)
LOCKOUT_DURATION=15

# ============================================================================
# LOGGING
# ============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file path
LOG_FILE=inmufacil.log
